<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FTGM Sim Database</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-color: #f4fbf7;
            --card-bg: #ffffff;
            --border-color: #e1efe6;
            --text-primary: #1c2e24;
            --text-secondary: #5a7365;
            --accent: #10b981;
            --accent-hover: #059669;
            --accent-light: #e6f7f0;
            --error-bg: #fef2f2;
            --error-border: #fca5a5;
            --error-text: #ef4444;
            --whatsapp-green: #25d366;
            --whatsapp-hover: #20ba5a;
            --shadow: 0 10px 30px rgba(16, 185, 129, 0.05);
            --card-shadow: 0 10px 25px rgba(28, 46, 36, 0.04);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 520px;
            margin-top: 40px;
        }

        header {
            text-align: center;
            margin-bottom: 35px;
        }

        header h1 {
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        header h1 span {
            color: var(--accent);
        }

        header p {
            font-size: 0.95rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .search-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: var(--card-shadow);
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .input-field {
            width: 100%;
            background-color: #ffffff;
            border: 2px solid var(--border-color);
            border-radius: 12px;
            padding: 16px;
            font-size: 1rem;
            color: var(--text-primary);
            outline: none;
            transition: all 0.25s ease;
            font-weight: 500;
        }

        .input-field:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 4px var(--accent-light);
        }

        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type=number] {
            -moz-appearance: textfield;
        }

        .btn {
            background-color: var(--accent);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.25s ease;
            width: 100%;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        }

        .btn:hover {
            background-color: var(--accent-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.3);
        }

        .btn:active {
            transform: translateY(1px);
        }

        .btn:disabled {
            background-color: var(--border-color);
            color: var(--text-secondary);
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        .loader {
            display: none;
            width: 48px;
            height: 48px;
            border: 5px solid var(--accent-light);
            border-bottom-color: var(--accent);
            border-radius: 50%;
            animation: rotation 1s linear infinite;
            margin: 30px auto;
        }

        @keyframes rotation {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .no-data-card {
            display: none;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 32px 24px;
            text-align: center;
            box-shadow: var(--card-shadow);
            animation: fadeIn 0.4s ease-out;
        }

        .no-data-icon {
            font-size: 3.5rem;
            color: var(--whatsapp-green);
            margin-bottom: 16px;
        }

        .no-data-card h3 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .no-data-card p {
            font-size: 0.95rem;
            color: var(--text-secondary);
            line-height: 1.5;
            margin-bottom: 24px;
        }

        .btn-whatsapp {
            background-color: var(--whatsapp-green);
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.2);
            text-decoration: none;
        }

        .btn-whatsapp:hover {
            background-color: var(--whatsapp-hover);
            box-shadow: 0 6px 20px rgba(37, 211, 102, 0.3);
            transform: translateY(-1px);
        }

        .results-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 30px;
        }

        .record-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--card-shadow);
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .record-header {
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 14px;
            margin-bottom: 18px;
        }

        .record-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--accent);
        }

        .record-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
        }

        @media (min-width: 480px) {
            .record-grid {
                grid-template-columns: 1fr 1fr;
            }
            .grid-full-width {
                grid-column: span 2;
            }
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .info-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.75px;
            color: var(--text-secondary);
            font-weight: 600;
        }

        .info-value {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .actions-bar {
            display: none;
            width: 100%;
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>FTGM <span>SIM DB</span></h1>
            <p>Developed By FTGM Official</p>
        </header>

        <main>
            <div class="search-card">
                <div class="input-group">
                    <input 
                        type="number" 
                        id="numInput" 
                        placeholder="Enter CNIC or Mobile Number" 
                        class="input-field"
                    >
                    <button onclick="fetchData()" id="searchBtn" class="btn">
                        <i id="btnIcon" class="fa-solid fa-search"></i> 
                        <span id="btnText">Search Database</span>
                    </button>
                </div>
            </div>

            <div id="loader" class="loader"></div>

            <div id="noDataBox" class="no-data-card">
                <div class="no-data-icon">
                    <i class="fa-brands fa-whatsapp"></i>
                </div>
                <h3>No Database Records Found</h3>
                <p>Join our official updates channel for assistance, manual verification requests, and regular tools updates.</p>
                <a href="https://whatsapp.com/channel/0029VbDQFi9KmCPUDQEwVW2W" target="_blank" class="btn btn-whatsapp">
                    <i class="fa-brands fa-whatsapp"></i> Follow WhatsApp Channel
                </a>
            </div>

            <div id="results" class="results-container"></div>

            <div id="actionsBar" class="actions-bar">
                <button id="copyBtn" onclick="handleCopy()" class="btn">
                    <i class="fa-solid fa-copy"></i> <span id="copyBtnText">Copy All Data</span>
                </button>
            </div>
        </main>
    </div>

    <script>
        let currentResults = null;

        document.getElementById('numInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') fetchData();
        });

        function getOperator(num) {
            if (!num) return 'Unknown';
            let clean = num.toString().replace(/\D/g, '');
            if (clean.startsWith('92')) {
                clean = '0' + clean.slice(2);
            }
            if (clean.length < 4) return 'Unknown';
            const prefix = clean.substring(0, 4);
            if (/^030[0-9]|^032[0-9]/.test(prefix)) return 'Jazz / Warid';
            if (/^034[0-9]/.test(prefix)) return 'Telenor';
            if (/^033[0-9]/.test(prefix)) return 'Ufone';
            if (/^031[0-9]/.test(prefix)) return 'Zong';
            if (/^0355/.test(prefix)) return 'Scom';
            return 'Unknown';
        }

        async function fetchData() {
            const inputEl = document.getElementById('numInput');
            const searchVal = inputEl.value.trim();
            
            if (!searchVal) {
                alert("Please enter a phone number or CNIC!");
                return;
            }

            const loader = document.getElementById('loader');
            const resultsDiv = document.getElementById('results');
            const noDataCard = document.getElementById('noDataBox');
            const searchBtn = document.getElementById('searchBtn');
            const btnIcon = document.getElementById('btnIcon');
            const btnText = document.getElementById('btnText');
            const actionsBar = document.getElementById('actionsBar');

            resultsDiv.innerHTML = "";
            noDataCard.style.display = 'none';
            actionsBar.style.display = 'none';
            
            loader.style.display = 'block';
            searchBtn.disabled = true;
            btnIcon.className = "fa-solid fa-circle-notch fa-spin";
            btnText.innerText = "Searching...";

            try {
                const response = await fetch(`https://ftgm-simdb-api.vercel.app?num=${searchVal}`);
                
                if (!response.ok) throw new Error("Server Error");
                const data = await response.json();

                loader.style.display = 'none';

                if (data && data.status === "Success" && Array.isArray(data.records) && data.records.length > 0) {
                    const normalizedRecords = data.records.map(r => ({
                        name: r.Name || 'N/A',
                        mobile: r.Mobile || 'N/A',
                        cnic: r.CNIC || 'N/A',
                        address: r.ADDRESS || 'Not Available',
                        operator: getOperator(r.Mobile)
                    }));

                    currentResults = normalizedRecords;
                    renderSuccess(normalizedRecords);
                    actionsBar.style.display = 'flex';
                } else {
                    noDataCard.style.display = 'block';
                }
            } catch (error) {
                loader.style.display = 'none';
                noDataCard.style.display = 'block';
            } finally {
                searchBtn.disabled = false;
                btnIcon.className = "fa-solid fa-search";
                btnText.innerText = "Search Database";
            }
        }

        function renderSuccess(records) {
            const resultsDiv = document.getElementById('results');
            let html = '';

            records.forEach((record, index) => {
                html += `
                <div class="record-card">
                    <div class="record-header">
                        <div class="record-title">Record #${index + 1}</div>
                    </div>
                    <div class="record-grid">
                        <div class="info-item grid-full-width">
                            <span class="info-label">Name</span>
                            <span class="info-value">${record.name}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Mobile</span>
                            <span class="info-value">${record.mobile}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">CNIC</span>
                            <span class="info-value">${record.cnic}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Operator</span>
                            <span class="info-value">${record.operator}</span>
                        </div>
                        <div class="info-item grid-full-width">
                            <span class="info-label">Address</span>
                            <span class="info-value">${record.address}</span>
                        </div>
                    </div>
                </div>`;
            });

            resultsDiv.innerHTML = html;
        }

        function handleCopy() {
            if (!currentResults) return;
            let textToCopy = currentResults.map((r, i) => 
                `--- Record ${i+1} ---\nName: ${r.name}\nMobile: ${r.mobile}\nCNIC: ${r.cnic}\nAddress: ${r.address}\nOperator: ${r.operator}`
            ).join('\n\n');

            const textArea = document.createElement("textarea");
            textArea.value = textToCopy;
            textArea.style.position = "fixed";
            textArea.style.top = "0";
            textArea.style.left = "0";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            
            try {
                document.execCommand('copy');
                const btnText = document.getElementById('copyBtnText');
                btnText.innerText = "Copied!";
                setTimeout(() => {
                    btnText.innerText = "Copy All Data";
                }, 2000);
            } catch (err) {
                alert("Failed to copy data.");
            }
            document.body.removeChild(textArea);
        }
    </script>
</body>
</html>